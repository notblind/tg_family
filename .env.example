# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# Admin Telegram IDs (comma-separated, e.g., 123456789,987654321)
ADMIN_IDS=

# Telegram Channel ID for reviews (e.g., -1001234567890)
CHANNEL_ID=

# Timezone (e.g., Europe/Belgrade)
TIMEZONE=

# Database URL (PostgreSQL from Railway)
DATABASE_URL=

# Pill reminder interval in minutes (e.g., 15)
PILL_REMINDER_INTERVAL=
